node scripts/check-route-isolation.js
node scripts/check-migration-numbering.js

# TypeScript 类型检查（防止类型错误被提交）
npx tsc --noEmit 2>&1 | head -30
if [ ${PIPESTATUS[0]} -ne 0 ]; then
  echo "❌ TypeScript 类型检查失败，请修复后再提交"
  exit 1
fi
echo "✓ TypeScript 类型检查通过"

# 只检查暂存的文件，保持提交速度；全量 lint 在 CI 里跑
STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx|mjs)$' || true)
if [ -n "$STAGED" ]; then
  echo "$STAGED" | xargs npx eslint --max-warnings=-1
  if [ $? -ne 0 ]; then
    echo "❌ ESLint 检查失败，请修复后再提交"
    exit 1
  fi
  echo "✓ ESLint 检查通过"
fi
